#!/bin/sh
#
# $FreBSD: nanopi-neo,v 1.1 2020/06/13 00:00:00 nuxy Exp $
#

# PROVIDE: nanopi-neo
# REQUIRE: NETWORKING SERVERS DAEMON
# BEFORE:  LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="nanopi-neo"
desc="NanoPi-NEO API services."
start_cmd="nanopi-neo_start"
stop_cmd="nanopi-neo_stop"
rcvar="nanopi-neo_enable"

nanopi-neo_start()
{
	base_dir=/nanopi-neo/server

	echo "Starting $desc"

	su -m nanopi-neo -c "screen -dm /usr/local/bin/npm run start --cwd $base_dir --prefix $base_dir > /dev/null 2>&1"
}

nanopi-neo_stop()
{
	echo "Stopping $desc"

	killall -u nanopi-neo
}

load_rc_config $name
run_rc_command "$1"
