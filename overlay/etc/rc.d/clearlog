#!/bin/sh
#
# $FreeBSD: clearlog,v 1.1 2020/06/13 00:00:00 nuxy Exp $
#

# PROVIDE: clearlog
# REQUIRE: log
# KEYWORD: shutdown

. /etc/rc.subr

name="clearlog"
desc="Remove old logs"
start_cmd=":"
stop_cmd="clearlog_stop"
rcvar="clear_log_enable"

clearlog_stop()
{
	echo $desc

	rm -f /var/log/*.gz
}

load_rc_config $name
run_rc_command "$1"
