#!/bin/sh
#
# $FreeBSD: setpass,v 1.1 2020/06/13 00:00:00 nuxy Exp $
#

# PROVIDE: setpass
# REQUIRE: tty
# BEFORE:  SERVERS

. /etc/rc.subr

name="setpass"
desc="Set root password"
start_cmd="setpass_start"
stop_cmd=":"
rcvar="setpass_enable"

setpass_start()
{
	insecure=`grep -c 'root:*:0:0::0:0:Charlie' /etc/master.passwd`

	if [ $insecure -eq 1 ]
	then
		echo -n "$desc\: "
		echo `openssl rand -hex 12` | pw usermod root -h 0
	fi
}

load_rc_config $name
run_rc_command "$1"
